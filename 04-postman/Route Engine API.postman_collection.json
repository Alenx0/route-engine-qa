  "item": [
    {
      "name": "Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status es 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Responde en menos de 2 segundos\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});\r\n\r\npm.test(\"Trae access_token\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.access_token).to.be.a(\"string\");\r\n});\r\n\r\npm.test(\"El rol es ADMIN\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.user.role).to.eql(\"ADMIN\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"admin@alenxo\",\r\n  \"password\": \"{{admin_password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "BUG-004 clave de 73 bytes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Una clave larga NO debe provocar error 500 (BUG-004)\", function () {\r\n    pm.expect(pm.response.code).to.not.equal(500);\r\n});\r\n\r\npm.test(\"Una clave larga debe responder 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"pwd_larga\", \"a\".repeat(73));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"admin@alenxo\",\r\n  \"password\": \"{{pwd_larga}}\"\r\n}",
