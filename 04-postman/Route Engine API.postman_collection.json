            "exec": [
              "pm.test(\"Status es 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"Mensaje genérico\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.error).to.eql(\"Credenciales inválidas\");\r\n});\r\n\r\npm.test(\"No entrega token\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.access_token).to.be.undefined;\r\n});"
